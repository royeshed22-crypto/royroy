generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DELETING
  DELETED
  SUSPENDED
}

enum ConsentType {
  TERMS_AND_PRIVACY
  AGE_VERIFICATION
  MARKETING
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  BLOCKED
}

enum Speaker {
  SELF
  OTHER
  SYSTEM
  UNKNOWN
}

enum MessageSource {
  SCREENSHOT
  MANUAL
  IMPORT
}

enum RelationshipStage {
  NEW_MATCH
  EARLY_CHAT
  FLIRTING
  PLANNING_DATE
  DATING
  COOLING_OFF
  ENDED
  UNCLEAR
}

enum ReplyTone {
  PLAYFUL
  DIRECT
  WARM
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                 String     @id @default(uuid())
  deviceId           String?    @unique @map("device_id")
  displayName        String?    @map("display_name")
  gender             String?
  goals              String[]
  communicationStyle String?    @map("communication_style")
  language           String     @default("he")
  timezone           String     @default("Asia/Jerusalem")
  eloScore           Int        @default(1000) @map("elo_score")
  streakDays         Int        @default(0) @map("streak_days")
  isPro              Boolean    @default(false) @map("is_pro")
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  consents   Consent[]
  contacts   Contact[]
  analyses   Analysis[]
  uploads    Upload[]

  @@map("users")
}

model Consent {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  consentType     ConsentType @map("consent_type")
  documentVersion String      @map("document_version")
  accepted        Boolean
  acceptedAt      DateTime    @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@map("consents")
}

model Contact {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  displayName      String        @map("display_name")
  platform         String?
  /// Free-text the user maintains: how they met, what's going on, anything.
  notes            String?
  /// Facts the model accumulates across analyses — inside jokes, things she
  /// mentioned, running threads. Shape: see ContactMemory in ai.service.ts.
  /// Structured knowledge accumulated across every scan. Shape: RelationshipMemory
  /// in memory.types.ts. Older rows hold the earlier flat shape; the parser
  /// upgrades them on read.
  aiMemory         Json?         @map("ai_memory")
  /// Where the relationship currently stands. Inferred, never asserted from a
  /// single exchange.
  stage            RelationshipStage?
  /// Prose summary of the relationship so far, rewritten only when it drifts.
  summary          String?
  status           ContactStatus @default(ACTIVE)
  currentVibeScore Int?          @map("current_vibe_score")
  lastActivityAt   DateTime?     @map("last_activity_at")
  archivedAt       DateTime?     @map("archived_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses Analysis[]
  messages ConversationMessage[]

  @@map("contacts")
}

/// The canonical, deduplicated timeline for one relationship. Messages live here
/// rather than on an Analysis so overlapping screenshots collapse into a single
/// continuous conversation.
model ConversationMessage {
  id         String   @id @default(uuid())
  contactId  String   @map("contact_id")
  userId     String   @map("user_id")

  speaker    Speaker
  text       String
  /// Position in the reconstructed conversation. Gaps are fine; only order matters.
  orderIndex Int      @map("order_index")

  /// Timestamp shown in the chat, when the screenshot exposed one.
  sentAt     DateTime? @map("sent_at")
  /// Raw timestamp text as read, e.g. "15:52" or "Yesterday".
  sentAtRaw  String?   @map("sent_at_raw")

  source          MessageSource @default(SCREENSHOT)
  sourceAnalysisId String?      @map("source_analysis_id")

  /// Normalised speaker+text digest, kept for inspection and seam matching.
  /// Deliberately NOT unique: short replies like "חחח" recur legitimately, and
  /// a uniqueness constraint would silently drop them.
  fingerprint String

  sentiment   String?
  score       Int?
  explanation String?

  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, orderIndex])
  @@index([contactId, fingerprint])
  @@map("conversation_messages")
}

model Upload {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  filename  String
  path      String
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis? @relation(fields: [analysisId], references: [id])
  analysisId String? @map("analysis_id")

  @@map("uploads")
}

model Analysis {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  contactId         String?        @map("contact_id")
  status            AnalysisStatus @default(PENDING)
  /// What the user typed before scanning: what a photo showed, what a voice
  /// note said, anything the screenshots can't convey on their own.
  userContext       String?        @map("user_context")
  /// True when this run was a bulk backfill of an existing conversation rather
  /// than a normal "what do I reply" scan.
  isImport          Boolean        @default(false) @map("is_import")
  /// Extraction outcome, surfaced to the user as "11 new, 7 already known".
  messagesFound     Int?           @map("messages_found")
  messagesNew       Int?           @map("messages_new")
  language          String?
  overallScore      Int?           @map("overall_score")
  vibeScore         Int?           @map("vibe_score")
  interestScore     Int?           @map("interest_score")
  confidence        Float?
  summary           String?
  conversationStage String?        @map("conversation_stage")
  recommendedAction Json?          @map("recommended_action")
  communicationStyle Json?         @map("communication_style")
  greenFlags        String[]       @map("green_flags")
  redFlags          String[]       @map("red_flags")
  disclaimer        String?
  modelVersion      String?        @map("model_version")
  promptVersion     String?        @map("prompt_version")
  failureCode       String?        @map("failure_code")
  createdAt         DateTime       @default(now()) @map("created_at")
  completedAt       DateTime?      @map("completed_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact  Contact?         @relation(fields: [contactId], references: [id])
  uploads  Upload[]
  replies  SuggestedReply[]

  @@map("analyses")
}

model SuggestedReply {
  id          String    @id @default(uuid())
  analysisId  String    @map("analysis_id")
  userId      String    @map("user_id")
  text        String
  tone        ReplyTone
  /// How strongly the tone is expressed: 1 = subtle, 2 = clear, 3 = full send.
  intensity   Int       @default(2)
  riskLevel   RiskLevel @map("risk_level")
  explanation String
  copiedAt    DateTime? @map("copied_at")
  rating      Int?
  createdAt   DateTime  @default(now()) @map("created_at")

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("suggested_replies")
}
