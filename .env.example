# Copy this file to .env and fill in the key. That is the only required step.
#
#   cp .env.example .env
#   docker compose up
#
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Everything below is optional — docker-compose supplies working defaults.

# JWT_SECRET=change-me-for-production
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest
