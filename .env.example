# Copy this file to .env and fill in the key. That is the only required step.
#
#   cp .env.example .env
#   docker compose up
#
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Everything below is optional — docker-compose supplies working defaults.

# Pin this to any long random string. If it changes, every issued token stops
# validating and clients have to re-authenticate.
# JWT_SECRET=some-long-random-string
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest
