# === apps/api/.env ===
# Copy these into apps/api/.env and fill in real values

# Database (Docker Compose maps Postgres to host port 5433)
DATABASE_URL="postgresql://dugrizz:dugrizz_secret@localhost:5433/dugrizz_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-use-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-flash-latest"

# API
API_PORT=3001
API_URL="http://localhost:3001"


# === apps/web/.env.local ===
# Copy this into apps/web/.env.local

NEXT_PUBLIC_API_URL="http://localhost:3001/v1"
